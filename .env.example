# Names of every environment variable the app reads. NO values here: this file is committed.
# Copy to `.env` (git-ignored) and fill in. The zod schema is packages/shared/src/app-env.ts.
#
# Where the real value lives in each environment:
#   local          .env
#   AWS Lambdas    SSM Parameter Store, /angiday/<param> (read at cold start)
#   Vercel (web)   Project Settings → Environment Variables

# --- MongoDB Atlas (worker + web) ---
# SSM: /angiday/mongodb-uri
# Must include the database name right after the host: …mongodb.net/angiday?... — without it,
# the driver silently connects to its default "test" database (this broke the S1 demo once).
MONGODB_URI=

# --- Telegram (ingest + worker) ---
# SSM: /angiday/telegram-bot-token
TELEGRAM_BOT_TOKEN=
# SSM: /angiday/telegram-webhook-secret (random hex; sent back by Telegram in X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# SSM: /angiday/allowed-chat-ids (comma-separated supergroup ids, each starting with -100)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Gemini via the AI SDK (worker + web chat) ---
# SSM: /angiday/gemini-api-key
# This is the name @ai-sdk/google reads by default, so getModel() needs no extra wiring.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Web app (Vercel; locally in apps/web/.env.local because Next.js reads env files from apps/web) ---
# One login for the group (Phase 1 plan → Web auth). Password: at least 12 characters.
WEB_LOGIN_USERNAME=
WEB_LOGIN_PASSWORD=
# Signs the session cookie: `openssl rand -hex 32`. Changing it logs everyone out.
SESSION_SECRET=
# The group's ObjectId (24 hex chars), printed by `pnpm seed:group`.
GROUP_ID=

# --- Set by CDK on the Lambdas, never in .env (see infra/lib/ingest-stack.ts) ---
# QUEUE_URL, POWERTOOLS_SERVICE_NAME, and <NAME>_PARAM = the SSM parameter name holding <NAME>.
