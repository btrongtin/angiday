# Names of every environment variable the app reads. NO values here: this file is committed.
# Copy to `.env` (git-ignored) and fill in. The zod schema is packages/shared/src/app-env.ts.
#
# Where the real value lives in each environment:
#   local          .env
#   AWS Lambdas    SSM Parameter Store, /angiday/<param> (read at cold start)
#   Vercel (web)   Project Settings → Environment Variables

# --- MongoDB Atlas (worker + web) ---
# SSM: /angiday/mongodb-uri
MONGODB_URI=

# --- Telegram (ingest + worker) ---
# SSM: /angiday/telegram-bot-token
TELEGRAM_BOT_TOKEN=
# SSM: /angiday/telegram-webhook-secret (random hex; sent back by Telegram in X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# SSM: /angiday/allowed-chat-ids (comma-separated supergroup ids, each starting with -100)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Gemini via the AI SDK (worker + web chat) ---
# SSM: /angiday/gemini-api-key
# This is the name @ai-sdk/google reads by default, so getModel() needs no extra wiring.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Proposed for S1 (not final; uncomment and agree on names when S1 starts) ---
# Web login (Phase 1 plan: credentials in Vercel env, signed httpOnly session cookie, groupId from env)
# WEB_LOGIN_USERNAME=
# WEB_LOGIN_PASSWORD=
# SESSION_SECRET=
# GROUP_ID=
