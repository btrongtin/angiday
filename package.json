{
  "name": "angiday",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "seed:group": "pnpm --filter @angiday/ingest run seed:group",
    "set-webhook": "pnpm --filter @angiday/ingest run set-webhook",
    "eval:extract": "pnpm --filter @angiday/ai run eval:extract"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "catalog:",
    "globals": "^17.13.0",
    "turbo": "^2.11.8",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  }
}
